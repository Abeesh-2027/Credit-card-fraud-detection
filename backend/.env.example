# Copy this file to .env for local development (never commit the real .env).
# On Render, set these under Dashboard -> your service -> Environment instead.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Demo login credentials (single-user demo auth, no database).
DEMO_USERNAME=admin
DEMO_PASSWORD=12345

# How long a login session lasts, in minutes.
ACCESS_TOKEN_MINUTES=120

# Comma-separated list of frontend origins allowed to call this API.
# Set this to your real Vercel URL once you have it, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
# Leave as * only for local testing.
ALLOWED_ORIGINS=*
